# CE-MARCA 示例 Notebook

## 1. 导入库

```python
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from causal_marca import CEMARCA
from causal_marca.utils import MicroRCALoader, ResultsVisualizer
```

## 2. 加载数据

```python
# 加载 MicroRCA 数据集
loader = MicroRCALoader("data/raw/microrca")
faults = loader.load_all()

print(f"Loaded {len(faults)} fault instances")

# 查看第一个故障
fault = faults[0]
print(f"Fault ID: {fault.fault_id}")
print(f"Architecture: {fault.architecture}")
print(f"Fault Type: {fault.fault_type}")
print(f"Root Cause: {fault.root_cause_service}")
```

## 3. 初始化 CE-MARCA

```python
# 加载依赖图
dep_graph_path = "data/processed/dependency_graph.json"

# 初始化
marca = CEMARCA(
    dependency_graph_path=dep_graph_path,
    llm_model="Qwen/Qwen2.5-7B-Instruct",
    significance_level=0.05,
    max_lag=5
)

print(f"Initialized CE-MARCA")
print(f"Graph statistics: {marca.get_graph_statistics()}")
```

## 4. 运行根因分析

```python
# 选择第一个故障进行测试
fault = faults[0]

# 准备数据
metrics_data = {
    "services": fault.metrics
}

logs_data = {
    "services": fault.logs
}

traces_data = {
    "traces": fault.traces
}

# 运行分析
report = marca.analyze(
    anomaly_timestamp=fault.timestamp_start,
    metrics_data=metrics_data,
    logs_data=logs_data,
    traces_data=traces_data
)

# 查看结果
print("=" * 50)
print("ROOT CAUSE ANALYSIS REPORT")
print("=" * 50)
print(f"Root Cause Service: {report['root_cause_service']}")
print(f"Confidence: {report['confidence']:.2%}")
print(f"Fault Pattern: {report['fault_pattern']}")
print(f"Causal Path: {' → '.join(report['causal_path'])}")
print(f"Analysis Time: {report['total_time_sec']:.2f}s")
print("=" * 50)
print("Recommendations:")
for rec in report['recommendations']:
    print(f"  - {rec}")
```

## 5. 批量评估

```python
from tqdm import tqdm

# 在测试集上评估
test_faults = faults[:20]  # 使用前 20 个故障作为示例

results = []
for fault in tqdm(test_faults, desc="Evaluating"):
    # 准备数据
    metrics_data = {"services": fault.metrics}
    logs_data = {"services": fault.logs}
    traces_data = {"traces": fault.traces}
    
    # 运行分析
    report = marca.analyze(
        anomaly_timestamp=fault.timestamp_start,
        metrics_data=metrics_data,
        logs_data=logs_data,
        traces_data=traces_data
    )
    
    # 记录结果
    results.append({
        "fault_id": fault.fault_id,
        "true_root_cause": fault.root_cause_service,
        "predicted_root_cause": report["root_cause_service"],
        "confidence": report["confidence"],
        "correct": report["root_cause_service"] == fault.root_cause_service,
        "analysis_time": report["total_time_sec"]
    })

# 转换为 DataFrame
results_df = pd.DataFrame(results)

# 计算准确率
accuracy = results_df["correct"].mean()
print(f"\nTop-1 Accuracy: {accuracy:.2%} ({results_df['correct'].sum()}/{len(results_df)})")
print(f"Average Confidence: {results_df['confidence'].mean():.2%}")
print(f"Average Analysis Time: {results_df['analysis_time'].mean():.2f}s")
```

## 6. 可视化结果

```python
# 创建可视化器
viz = ResultsVisualizer(output_dir="results/figures")

# 准确率对比（假设有基线结果）
baseline_results = {
    "Standard RAG": 0.55,
    "Graph-RAG": 0.68,
    "mABC": 0.72,
    "CE-MARCA (Ours)": accuracy
}

viz.plot_accuracy_comparison(
    baseline_results,
    title="Root Cause Analysis Accuracy Comparison",
    save_name="accuracy_comparison.png"
)

# 显示混淆矩阵
viz.plot_confusion_matrix(
    y_true=results_df["true_root_cause"],
    y_pred=results_df["predicted_root_cause"],
    title="Confusion Matrix - Root Cause Services",
    save_name="confusion_matrix.png"
)
```

## 7. 案例分析

```python
# 选择一个成功案例
correct_results = results_df[results_df["correct"] == True]
if len(correct_results) > 0:
    case_id = correct_results.iloc[0]["fault_id"]
    case_fault = next(f for f in faults if f.fault_id == case_id)
    
    print(f"\n=== Case Study: {case_id} ===")
    print(f"Architecture: {case_fault.architecture}")
    print(f"Fault Type: {case_fault.fault_type}")
    print(f"True Root Cause: {case_fault.root_cause_service}")
    print(f"Predicted: {correct_results.iloc[0]['predicted_root_cause']}")
    print(f"Confidence: {correct_results.iloc[0]['confidence']:.2%}")

# 选择一个失败案例
incorrect_results = results_df[results_df["correct"] == False]
if len(incorrect_results) > 0:
    case_id = incorrect_results.iloc[0]["fault_id"]
    case_fault = next(f for f in faults if f.fault_id == case_id)
    
    print(f"\n=== Failure Case: {case_id} ===")
    print(f"True Root Cause: {case_fault.root_cause_service}")
    print(f"Predicted: {incorrect_results.iloc[0]['predicted_root_cause']}")
    print(f"Confidence: {incorrect_results.iloc[0]['confidence']:.2%}")
    print("Possible reasons for failure:")
    print("  - Insufficient causal evidence")
    print("  - Complex fault propagation pattern")
    print("  - Missing monitoring data")
```

## 8. 保存结果

```python
# 保存结果到 CSV
results_df.to_csv("results/metrics/experiment_results.csv", index=False)

# 保存统计信息
summary = {
    "total_faults": len(results_df),
    "correct_predictions": int(results_df["correct"].sum()),
    "accuracy": float(accuracy),
    "avg_confidence": float(results_df["confidence"].mean()),
    "avg_analysis_time_sec": float(results_df["analysis_time"].mean())
}

import json
with open("results/metrics/summary.json", "w") as f:
    json.dump(summary, f, indent=2)

print(f"\nResults saved to results/metrics/")
```
